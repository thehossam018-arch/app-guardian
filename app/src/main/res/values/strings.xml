    <string name="app_name">App Guardian</string>

    <string name="accessibility_service_description">App Guardian uses this service only to notice which app is currently open, so it can show a block screen if that app is on your blocked list. It never reads, stores, or sends personal content, and nothing ever leaves your device.</string>

